{
  "name": "osservatorio-versilia-watchdog",
  "main": "worker.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["30 9 * * *"]
  },
