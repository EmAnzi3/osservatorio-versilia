{
  "schemaVersion": 1,
  "scope": {
    "catalog": "effective-public-catalog",
    "purpose": "Regole comuni per formattazione, scale, confronto, benchmark e dati mancanti.",
    "noMetricInventory": true
  },
  "missingData": {
    "nullToken": "n.d.",
    "nullLabel": "Dato non disponibile",
    "notApplicableFlag": "notApplicable",
    "notApplicableToken": "n.a.",
    "notApplicableLabel": "Non applicabile",
    "mustRemainDistinct": true
  },
  "polarity": {
    "allowed": [
      "neutral",
      "positive",
      "negative"
    ],
    "rankingOrder": "descending-numeric",
    "colorMeaning": "theme-not-quality",
    "interpretationOnly": true
  },
  "comparison": {
    "referenceField": "meta.comparisonReference",
    "allowedReferences": [
      "aggregate"
    ],
    "fallbackWhenOmitted": "simple-mean-available-towns",
    "differenceField": "meta.comparisonDifference",
    "allowedDifferenceModes": [
      "percentagePoints",
      "absolute",
      "shareOfAggregate"
    ],
    "defaultDifferenceMode": "relativePercent",
    "declaredAggregateField": "aggregate"
  },
  "aggregation": {
    "ratioComponentsField": "ratioComponents",
    "ratioFormula": "sum(numerator) / sum(denominator) * scale",
    "requireDeclaredAggregateForRatioComponents": true,
    "denominatorMustBeNonZero": true,
    "absoluteTolerance": 1e-7,
    "relativeTolerance": 1e-10,
    "classifyAggregateAgainstTownValues": true
  },
  "benchmarks": {
    "metricField": "meta.benchmark",
    "requiredFields": [
      "year",
      "source",
      "url",
      "note"
    ],
    "valueFields": [
      "tuscany",
      "italy"
    ],
    "allowPartialValues": true
  },
  "scales": {
    "percent": {
      "zeroBased": true,
      "fullRangeThreshold": 60,
      "fullRangeMax": 100
    },
    "nonNegative": {
      "zeroBased": true
    },
    "nonPositive": {
      "zeroAnchored": true
    },
    "signed": {
      "symmetricAroundZero": true
    },
    "eurliter": {
      "focused": true
    }
  },
  "tooltips": {
    "missingUsesNullToken": true,
    "notApplicableUsesDistinctToken": true,
    "ariaAndVisibleValueMustShareFormatter": true
  },
  "units": {
    "number": {
      "family": "count",
      "fractionDigits": 0,
      "suffix": "",
      "genericSurface": true
    },
    "count": {
      "family": "count",
      "fractionDigits": 0,
      "suffix": "",
      "genericSurface": true
    },
    "people": {
      "family": "count",
      "fractionDigits": 0,
      "suffix": " persone",
      "genericSurface": true
    },
    "currency": {
      "family": "currency",
      "fractionDigits": 0,
      "suffix": " €",
      "genericSurface": true
    },
    "currency2": {
      "family": "currency",
      "fractionDigits": 2,
      "suffix": " €",
      "genericSurface": true
    },
    "millionCurrency": {
      "family": "currency-million",
      "fractionDigits": 1,
      "suffix": " mln €",
      "genericSurface": true
    },
    "percent": {
      "family": "percent",
      "fractionDigits": 1,
      "suffix": "%",
      "genericSurface": true
    },
    "%": {
      "family": "percent",
      "fractionDigits": 2,
      "suffix": "%",
      "genericSurface": true
    },
    "percent2": {
      "family": "percent",
      "fractionDigits": 2,
      "suffix": "%",
      "genericSurface": true
    },
    "percentagePoints": {
      "family": "percentage-points",
      "fractionDigits": 1,
      "suffix": "%",
      "genericSurface": true
    },
    "index": {
      "family": "index",
      "fractionDigits": 1,
      "suffix": "",
      "genericSurface": true
    },
    "invalsi_score": {
      "family": "score",
      "fractionDigits": 1,
      "suffix": "",
      "genericSurface": true
    },
    "decimal": {
      "family": "decimal",
      "fractionDigits": 2,
      "suffix": "",
      "genericSurface": true
    },
    "years": {
      "family": "duration-years",
      "fractionDigits": 2,
      "suffix": " anni",
      "genericSurface": true
